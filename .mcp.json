{
  "mcpServers": {
    "jira": {
      "command": "cmd",
      "args": ["/c", "agentsecrets", "env", "--", "uvx", "--python", "3.12", "mcp-atlassian"]
    },
    "qase": {
      "command": "cmd",
      "args": ["/c", "agentsecrets", "env", "--", "npx", "-y", "@qase/mcp-server"]
    },
    "playwright": {
      "command": "cmd",
      "args": ["/c", "npx", "-y", "@playwright/mcp@latest"]
    }
  }
}